<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Header with Logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="40dp"
            android:paddingBottom="32dp"
            android:paddingHorizontal="24dp">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="90dp"
                android:src="@drawable/logo_gxnova"
                android:contentDescription="Logo GXNOVA" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GXNOVA"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conectamos talento con oportunidades"
                android:textColor="#B0A08A"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Form Card with rounded top -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_white_rounded_top"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- Tab Switcher -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_tabs"
                android:layout_marginBottom="24dp"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tabLogin"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Iniciar Sesion"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/naranja_on_container"
                    android:background="@drawable/bg_tab_active" />

                <TextView
                    android:id="@+id/tabRegister"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Registrarse"
                    android:textSize="15sp"
                    android:textColor="@color/on_surface_variant"
                    android:background="@drawable/bg_tab_inactive" />
            </LinearLayout>

            <!-- Login Form -->
            <LinearLayout
                android:id="@+id/layoutLogin"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Bienvenido de vuelta"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:textColor="@color/on_surface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Ingresa tus credenciales para continuar"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="28dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Email"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <EditText
                    android:id="@+id/inputEmailLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="tu@email.com"
                    android:textColorHint="@color/on_surface_dim"
                    android:textColor="@color/on_surface"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_input_m3"
                    android:layout_marginBottom="20dp"
                    android:textSize="15sp"
                    android:singleLine="true" />

                <TextView
                    android:text="Contrasena"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp">

                    <EditText
                        android:id="@+id/inputPasswordLogin"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="Tu contrasena"
                        android:textColorHint="@color/on_surface_dim"
                        android:textColor="@color/on_surface"
                        android:inputType="textPassword"
                        android:paddingHorizontal="16dp"
                        android:paddingEnd="48dp"
                        android:background="@drawable/bg_input_m3"
                        android:textSize="15sp"
                        android:singleLine="true" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/eyes"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Mostrar Contrasena" />
                </RelativeLayout>

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Iniciar Sesion"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_button_primary" />
            </LinearLayout>

            <!-- Register Form -->
            <LinearLayout
                android:id="@+id/layoutRegister"
                android:visibility="gone"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Crea tu cuenta"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:textColor="@color/on_surface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Completa tus datos para comenzar"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="28dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="52dp"
                        android:hint="Nombres"
                        android:textColorHint="@color/on_surface_dim"
                        android:textColor="@color/on_surface"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_input_m3"
                        android:layout_marginEnd="10dp"
                        android:textSize="15sp"
                        android:singleLine="true" />

                    <EditText
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="52dp"
                        android:hint="Apellidos"
                        android:textColorHint="@color/on_surface_dim"
                        android:textColor="@color/on_surface"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_input_m3"
                        android:textSize="15sp"
                        android:singleLine="true" />
                </LinearLayout>

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Telefono"
                    android:textColorHint="@color/on_surface_dim"
                    android:textColor="@color/on_surface"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_input_m3"
                    android:layout_marginBottom="16dp"
                    android:textSize="15sp"
                    android:singleLine="true" />

                <Spinner
                    android:id="@+id/spCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_spinner"
                    android:layout_marginBottom="16dp"
                    android:popupTheme="@style/SpinnerPopup" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="tu@email.com"
                    android:textColorHint="@color/on_surface_dim"
                    android:textColor="@color/on_surface"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_input_m3"
                    android:layout_marginBottom="16dp"
                    android:textSize="15sp"
                    android:singleLine="true" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Contrasena"
                    android:textColorHint="@color/on_surface_dim"
                    android:textColor="@color/on_surface"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_input_m3"
                    android:layout_marginBottom="16dp"
                    android:textSize="15sp"
                    android:singleLine="true" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp">

                    <EditText
                        android:id="@+id/inputPasswordRegister"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="Confirma contrasena"
                        android:textColorHint="@color/on_surface_dim"
                        android:textColor="@color/on_surface"
                        android:inputType="textPassword"
                        android:paddingHorizontal="16dp"
                        android:paddingEnd="48dp"
                        android:background="@drawable/bg_input_m3"
                        android:textSize="15sp"
                        android:singleLine="true" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/eyes"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Mostrar Contrasena" />
                </RelativeLayout>

                <Button
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Crear Cuenta"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_button_primary" />
            </LinearLayout>

            <!-- Footer -->
            <TextView
                android:text="2025 GXNOVA - Todos los derechos reservados"
                android:textColor="@color/on_surface_dim"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="24dp"
                android:layout_height="wrap_content"
                android:layout_width="match_parent" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
